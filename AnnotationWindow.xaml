<Window x:Class="GlassShot.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="GlassShot Editor"
        Icon="icon.ico"
        Width="800" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <Button Content="Arrow" Margin="5,0" Padding="10,5" Click="Tool_Click" Tag="Arrow"/>
                <Button Content="Rectangle" Margin="5,0" Padding="10,5" Click="Tool_Click" Tag="Rect"/>
                <Button Content="Blur" Margin="5,0" Padding="10,5" Click="Tool_Click" Tag="Blur"/>
                <Separator Margin="10,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
                <Button Content="Background" Margin="5,0" Padding="10,5" Click="Background_Click"/>
                <Separator Margin="10,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
                <Button Content="Undo" Margin="5,0" Padding="10,5" Click="Undo_Click"/>
                <Button Content="Save" Margin="5,0" Padding="10,5" Click="Save_Click"/>
            </StackPanel>
        </Border>

        <!-- Canvas -->
        <Border Grid.Row="1" Margin="20" Background="Transparent">
            <!-- Drop shadow for the image canvas itself -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="10" Opacity="0.5"/>
            </Border.Effect>
            <skia:SKElement x:Name="SkiaCanvas" PaintSurface="SkiaCanvas_PaintSurface" 
                            MouseDown="SkiaCanvas_MouseDown" 
                            MouseMove="SkiaCanvas_MouseMove" 
                            MouseUp="SkiaCanvas_MouseUp"/>
        </Border>
    </Grid>
</Window>

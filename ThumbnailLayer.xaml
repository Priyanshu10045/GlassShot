<UserControl x:Class="GlassShot.ThumbnailLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="240" Height="160"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
             MouseDoubleClick="UserControl_MouseDoubleClick"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             RenderTransformOrigin="0.5,0.5">
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="ScaleTrans" ScaleX="1" ScaleY="1"/>
            <TranslateTransform x:Name="TranslateTrans" X="0" Y="0"/>
        </TransformGroup>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <Style TargetType="Button" x:Key="HoverButtonStyle">
            <Setter Property="Background" Value="#B3000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Border Margin="15" CornerRadius="8" Background="Transparent">
        <Border.CacheMode>
            <BitmapCache RenderAtScale="1.0" EnableClearType="False"/>
        </Border.CacheMode>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.5" Color="Black" RenderingBias="Performance"/>
        </Border.Effect>
        <Grid>
            <!-- Sleek rounded image with no white background bleeding -->
            <Border CornerRadius="8" ClipToBounds="True" Background="#111111">
                <Image x:Name="ThumbnailImage" Stretch="Uniform"/>
            </Border>
            
            <Ellipse x:Name="PlayIcon" Width="40" Height="40" Fill="#80000000" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path x:Name="PlayTriangle" Data="M 15,10 L 15,30 L 30,20 Z" Fill="White" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Hover actions overlay with dark semi-transparent background to make buttons pop -->
            <Border x:Name="ActionPanel" Visibility="Hidden" CornerRadius="8" Background="#40000000">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Copy" Style="{StaticResource HoverButtonStyle}" Click="Copy_Click"/>
                    <Button Content="Save" Style="{StaticResource HoverButtonStyle}" Click="Save_Click"/>
                    <Button Content="GIF" Style="{StaticResource HoverButtonStyle}" Click="Gif_Click" x:Name="GifButton" Visibility="Collapsed"/>
                    <Button Content="Text" Style="{StaticResource HoverButtonStyle}" Click="Text_Click" x:Name="TextButton" ToolTip="Extract Text (OCR)"/>
                    <Button Content="Edit" Style="{StaticResource HoverButtonStyle}" Click="Edit_Click" x:Name="EditButton" ToolTip="Open Annotator"/>
                    <Button Content="Pin" Style="{StaticResource HoverButtonStyle}" Click="Pin_Click" x:Name="PinButton" ToolTip="Pop out to floating Click-Through Widget"/>
                    <Button Content="⚙" Style="{StaticResource HoverButtonStyle}" Click="Settings_Click" ToolTip="Preferences"/>
                    <Button Content="✕" Style="{StaticResource HoverButtonStyle}" Click="Close_Click"/>
                </WrapPanel>
            </Border>
            
            <TextBlock x:Name="DragHint" Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>

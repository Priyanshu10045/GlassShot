<Window x:Class="GlassShot.RecordingControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording" Height="60" Width="180"
        WindowStyle="None" AllowsTransparency="True" Background="#E61A1A1A"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Loaded="Window_Loaded">
    <Window.Resources>
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RecordDot" Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:1" AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
        </EventTrigger>
    </Window.Triggers>
    <Border CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
            <Ellipse x:Name="RecordDot" Width="12" Height="12" Fill="Red" Margin="0,0,10,0"/>
            <TextBlock x:Name="TimerText" Text="00:00" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Width="50"/>
            <Button Content="Stop" Width="60" Height="30" Margin="10,0,0,0" Background="#33FFFFFF" Foreground="White" BorderThickness="0" Click="Stop_Click"/>
        </StackPanel>
    </Border>
</Window>
